{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["page", "elements"],
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "elements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["locator_type", "locator_value"],
        "additionalProperties": false,
        "properties": {
          "locator_type": {
            "type": "string",
            "enum": ["placeholder", "text", "css", "role"]
          },
          "locator_value": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "locator_type": {
                  "const": "role"
                }
              }
            },
            "then": {
              "required": ["role"]
            }
          }
        ]
      }
    }
  }
}
