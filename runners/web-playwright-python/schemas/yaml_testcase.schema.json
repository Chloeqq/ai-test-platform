{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "id", "title", "module", "execution"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "legacy_case_id": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "page_code": {
      "type": "string"
    },
    "chain_stage": {
      "type": "string"
    },
    "sut_service": {
      "type": "string"
    },
    "related_services": {
      "type": ["string", "array"],
      "items": {
        "type": "string"
      }
    },
    "page_name": {
      "type": "string"
    },
    "module_code": {
      "type": "string"
    },
    "module_name": {
      "type": "string"
    },
    "case_type": {
      "type": "string"
    },
    "case_type_name": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "status_name": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "change_source": {
      "type": "string"
    },
    "ai_status": {
      "type": "string"
    },
    "ai_status_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requirement": {
      "type": ["array", "object", "string"],
      "items": {
        "type": "string"
      },
      "additionalProperties": true
    },
    "precondition_state": {
      "type": "string"
    },
    "expected_result": {
      "type": "string"
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": ["assert_visible", "assert_count", "assert_metric", "assert_text", "assert_url"]
          },
          "target": {
            "type": ["string", "null"]
          },
          "target_name": {
            "type": ["string", "null"]
          },
          "selector": {
            "type": ["string", "null"]
          },
          "locator_type": {
            "type": ["string", "null"]
          },
          "locator_value": {
            "type": ["string", "null"]
          },
          "role": {
            "type": ["string", "null"]
          },
          "intent_id": {
            "type": ["string", "null"]
          },
          "element_code": {
            "type": ["string", "null"]
          },
          "count": {
            "type": ["integer", "number", "string", "null"]
          },
          "metric_rule": {
            "type": ["string", "number", "null"]
          },
          "rule": {
            "type": ["string", "number", "null"]
          },
          "extract_regex": {
            "type": ["string", "null"]
          },
          "metric_label": {
            "type": ["string", "null"]
          },
          "page": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "value": {
            "type": ["string", "number", "boolean", "object", "array", "null"]
          },
          "source_point_key": {
            "type": ["string", "null"]
          },
          "traceability": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "expected_result": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "enum": ["assert_visible", "assert_count", "assert_metric", "assert_text"]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": ["target"]
                },
                {
                  "required": ["element_code"]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": ["assert_metric"]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": ["value"]
                },
                {
                  "required": ["metric_rule"]
                },
                {
                  "required": ["rule"]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": ["assert_text", "assert_url"]
                }
              }
            },
            "then": {
              "required": ["value"]
            }
          }
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "scenario": { "type": "object", "additionalProperties": true },
    "case": { "type": "object", "additionalProperties": true },
    "actors": { "type": "object", "additionalProperties": true },
    "environment": { "type": "object", "additionalProperties": true },
    "coverage": { "type": "object", "additionalProperties": true },
    "data": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array"
          },
          {
            "type": ["string", "number", "boolean", "null"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_type": {
                "type": "string",
                "enum": ["inline", "pool", "env"]
              },
              "value": {
                "type": ["string", "number", "boolean", "object", "array", "null"]
              },
              "pool_name": {
                "type": ["string", "null"]
              },
              "key": {
                "type": ["string", "null"]
              }
            },
            "required": ["source_type"],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source_type": {
                      "const": "inline"
                    }
                  }
                },
                "then": {
                  "required": ["value"]
                }
              },
              {
                "if": {
                  "properties": {
                    "source_type": {
                      "const": "pool"
                    }
                  }
                },
                "then": {
                  "required": ["pool_name", "key"]
                }
              },
              {
                "if": {
                  "properties": {
                    "source_type": {
                      "const": "env"
                    }
                  }
                },
                "then": {
                  "required": ["key"]
                }
              }
            ]
          }
        ]
      }
    },
    "execution": {
      "type": "object",
      "required": ["runner", "page", "steps"],
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string",
          "enum": ["playwright", "api", "mobile"]
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "additionalProperties": true
        },
        "page_url": {
          "type": "string"
        },
        "selected_intent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "enum": ["login", "click", "fill", "input", "type", "wait_for", "wait", "assert_visible", "assert_count", "assert_metric", "assert_text", "assert_url", "goto", "open", "network_condition"]
              },
              "target": {
                "type": ["string", "null"]
              },
              "target_name": {
                "type": ["string", "null"]
              },
              "selector": {
                "type": ["string", "null"]
              },
              "locator_type": {
                "type": ["string", "null"]
              },
              "locator_value": {
                "type": ["string", "null"]
              },
              "role": {
                "type": ["string", "null"]
              },
              "intent_id": {
                "type": ["string", "null"]
              },
              "element_code": {
                "type": ["string", "null"]
              },
              "count": {
                "type": ["integer", "number", "string", "null"]
              },
              "metric_rule": {
                "type": ["string", "number", "null"]
              },
              "rule": {
                "type": ["string", "number", "null"]
              },
              "extract_regex": {
                "type": ["string", "null"]
              },
              "metric_label": {
                "type": ["string", "null"]
              },
              "page": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "value": {
                "type": ["string", "number", "boolean", "object", "array", "null"]
              },
              "source_point_key": {
                "type": ["string", "null"]
              },
              "traceability": {
                "type": ["object", "null"],
                "additionalProperties": true
              },
              "expected_result": {
                "type": ["string", "null"]
              },
              "url": { "type": ["string", "null"] },
              "target_url": { "type": ["string", "null"] },
              "timeout_ms": { "type": ["integer", "number", "string", "null"] },
              "network_condition": { "type": ["string", "null"] }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "enum": ["click", "fill", "input", "wait_for", "assert_visible", "assert_count", "assert_metric", "assert_text"]
                    }
                  }
                },
                "then": {
                  "anyOf": [
                    {
                      "required": ["target"]
                    },
                    {
                      "required": ["element_code"]
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "enum": ["assert_metric"]
                    }
                  }
                },
                "then": {
                  "anyOf": [
                    {
                      "required": ["value"]
                    },
                    {
                      "required": ["metric_rule"]
                    },
                    {
                      "required": ["rule"]
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "enum": ["fill", "input", "assert_text", "assert_url", "goto"]
                    }
                  }
                },
                "then": {
                  "required": ["value"]
                }
              }
            ]
          }
        }
      }
    }
  }
}
