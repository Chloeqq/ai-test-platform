{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "id", "title", "module", "execution"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "legacy_case_id": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "page_code": {
      "type": "string"
    },
    "chain_stage": {
      "type": "string"
    },
    "sut_service": {
      "type": "string"
    },
    "related_services": {
      "type": ["string", "array"],
      "items": {
        "type": "string"
      }
    },
    "page_name": {
      "type": "string"
    },
    "module_code": {
      "type": "string"
    },
    "module_name": {
      "type": "string"
    },
    "case_type": {
      "type": "string"
    },
    "case_type_name": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "status_name": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "change_source": {
      "type": "string"
    },
    "ai_status": {
      "type": "string"
    },
    "ai_status_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requirement": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "type": "array"
      }
    },
    "execution": {
      "type": "object",
      "required": ["runner", "page", "steps"],
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string",
          "enum": ["playwright", "api", "mobile"]
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "type": "object",
          "additionalProperties": true
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "enum": ["login", "click", "fill", "wait_for", "assert_visible", "assert_count", "assert_url", "goto"]
              },
              "target": {
                "type": ["string", "null"]
              },
              "element_code": {
                "type": ["string", "null"]
              },
              "count": {
                "type": ["integer", "number", "string", "null"]
              },
              "page": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "value": {
                "type": ["string", "number", "boolean", "object", "array", "null"]
              },
              "source_point_key": {
                "type": ["string", "null"]
              },
              "traceability": {
                "type": ["object", "null"],
                "additionalProperties": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "enum": ["click", "fill", "wait_for", "assert_visible", "assert_count"]
                    }
                  }
                },
                "then": {
                  "anyOf": [
                    {
                      "required": ["target"]
                    },
                    {
                      "required": ["element_code"]
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "enum": ["fill", "assert_url", "goto"]
                    }
                  }
                },
                "then": {
                  "required": ["value"]
                }
              }
            ]
          }
        }
      }
    }
  }
}
