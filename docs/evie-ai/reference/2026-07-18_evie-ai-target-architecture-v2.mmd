        D_ANALYTICS[("ClickHouse（可选）<br/>执行明细 / 大规模指标 / 长期分析")]

        D_OBSERVE[("Prometheus / OpenTelemetry / Langfuse<br/>系统指标 / 业务指标 / Trace / 模型调用观测")]
    end

    I_REQUIREMENT --> D_PG
    I_EVIDENCE --> D_JSON
    S_ASSET --> D_PG
    S_SOURCE --> D_PG
    S_REVIEW --> D_PG
    C_CASE --> D_PG
    C_TRACE --> D_JSON
    R_GATEWAY --> D_PG
    E_RECORD --> D_PG
    E_EVIDENCE --> D_OBJECT
    AI_REQ_RAG <--> D_VECTOR
    AI_EXEC_RETRIEVAL <--> D_VECTOR
    AI_GATEWAY --> D_OBSERVE
    E_ORCH --> D_REDIS
    P_TASK --> D_REDIS
    R_SECRET --> D_VAULT
    I_CHANNELS --> D_OBJECT
    R_API_SPEC --> D_OBJECT
