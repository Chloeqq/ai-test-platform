# Web
BASE_URL=http://localhost:5173/login#/login
# Optional: login E2E against your SPA (make test-e2e-login). Defaults to http://localhost:5173/#/login if unset.
# LOGIN_E2E_BASE_URL=http://localhost:5173/#/login
# In-repo demo (no external UI): make test-e2e-login-demo

# Test Account (set real credentials, do NOT commit actual passwords)
TEST_USERNAME=
TEST_PASSWORD=

# API
API_BASE_URL=http://localhost:8080

# AI
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.6-plus

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_PREFIX=aitest

# Database (set real credentials)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/ai_test_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_AUTO_CREATE_TABLES=true
WORKBENCH_STATE_BACKEND=database

# Orchestrator
ORCHESTRATOR_URL=http://localhost:8000
ORCHESTRATOR_TIMEOUT_SECONDS=45
ORCHESTRATOR_API_KEY=

# JWT (set a strong secret for production)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Admin bootstrap (set real credentials)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_ROLE=admin

# Logging
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=

# Docker ELK host ports (avoid conflicts with other projects)
ELASTICSEARCH_HOST_PORT=19200
KIBANA_HOST_PORT=15601
