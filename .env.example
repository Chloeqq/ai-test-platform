# Web
BASE_URL=http://localhost:5173/login#/login

# Test Account
TEST_USERNAME=admin
TEST_PASSWORD=macro123

# API
API_BASE_URL=http://localhost:8080

# AI
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.6-plus

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_PREFIX=aitest

# Database
DATABASE_URL=postgresql+psycopg2://aitest:aitest@localhost:5432/ai_test_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_AUTO_CREATE_TABLES=true
WORKBENCH_STATE_BACKEND=database

# Orchestrator
ORCHESTRATOR_URL=http://localhost:8000
ORCHESTRATOR_TIMEOUT_SECONDS=45

# Logging
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=

# Docker ELK host ports (avoid conflicts with other projects)
ELASTICSEARCH_HOST_PORT=19200
KIBANA_HOST_PORT=15601
