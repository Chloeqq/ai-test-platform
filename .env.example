# AI Test Platform 环境变量参考
# 复制为 .env 并根据本地环境修改

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg2://aitest:your-password@127.0.0.1:5432/ai_test_platform
POSTGRES_DB=ai_test_platform
POSTGRES_USER=aitest
POSTGRES_PASSWORD=your-password

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# ---- MinIO (需求文档存档) ----
MINIO_ENABLED=true
# 容器内用 minio:9000；本机直连用 127.0.0.1:9000
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REQUIREMENT_BUCKET=ai-requirements
MINIO_SECURE=false
MINIO_REGION=
# 宿主机端口映射（可选）
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---- 需求文档上传（参数化，不硬编码） ----
# 单文件大小上限（字节），默认 20MB
REQUIREMENT_UPLOAD_MAX_BYTES=20971520
# 允许的扩展名白名单（逗号分隔）
REQUIREMENT_UPLOAD_ALLOWED_EXTS=.docx,.pdf,.md

# ---- JWT / Auth ----
JWT_SECRET_KEY=your-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_ROLE=admin

# ---- Orchestrator ----
ORCHESTRATOR_URL=http://127.0.0.1:8000
ORCHESTRATOR_API_KEY=your-orchestrator-key

# ---- LLM (orchestrator 必需) ----
DOCKER_OPENAI_API_KEY=your-api-key
DOCKER_OPENAI_BASE_URL=https://api.openai.com/v1
DOCKER_OPENAI_MODEL=gpt-4

# ---- Workbench State ----
WORKBENCH_STATE_BACKEND=database

# ---- URLs ----
BASE_URL=http://localhost:5174/#/login

# ---- E2E 测试 ----
TEST_USERNAME=admin
TEST_PASSWORD=your-test-password
